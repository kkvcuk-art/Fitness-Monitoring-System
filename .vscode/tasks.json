{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Start Backend Server (Port 5000)",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "server",
        "reveal": "always"
      }
    },
    {
      "type": "shell",
      "label": "Start Frontend Web App (Port 5173)",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "server",
        "reveal": "always"
      }
    },
    {
      "label": "Run Both Backend & Frontend",
      "dependsOn": [
        "Start Backend Server (Port 5000)",
        "Start Frontend Web App (Port 5173)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
